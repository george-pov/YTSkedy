# Thumbnail checks use a local image file that is not tracked. Put a small JPEG
# or PNG under build/manual-checks/thumbnail.png before running upload requests.
# Keep bearer tokens, deployed URLs, and personal image files out of tracked
# files.

### UploadCalendarEventThumbnail
# Prereqs:
# - Calendar event exists and has no platform publication rows.
# - Local file exists at ../../../../../build/manual-checks/thumbnail.png,
#   relative to this .http file.
# Expected response: 200 OK with { fileName, contentType, sizeBytes, width,
# height, updatedUtc }. Details GET then returns thumbnail metadata and
# canUpdateThumbnail true.

PUT {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/thumbnail
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----YTSkedyThumbnailBoundary

------YTSkedyThumbnailBoundary
Content-Disposition: form-data; name="thumbnail"; filename="thumbnail.png"
Content-Type: image/png

< ../../../../../build/manual-checks/thumbnail.png
------YTSkedyThumbnailBoundary--

### GetCalendarEventThumbnail
# Run after UploadCalendarEventThumbnail.
# Expected response: 200 OK with image bytes and the stored image content type.

GET {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/thumbnail
Authorization: Bearer {{accessToken}}

### GetCalendarEventThumbnail when none exists
# Use an event with no thumbnail metadata.
# Expected response: 404 Not Found.

GET {{HostAddress}}/api/calendar-events/REPLACE_WITH_EVENT_WITHOUT_THUMBNAIL_ID/thumbnail
Authorization: Bearer {{accessToken}}

### DeleteCalendarEventThumbnail
# Run after UploadCalendarEventThumbnail.
# Expected response: 204 No Content. Details GET then returns thumbnail null and
# canUpdateThumbnail true.

DELETE {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/thumbnail
Authorization: Bearer {{accessToken}}

### DeleteCalendarEventThumbnail when none exists
# Expected response: 404 Not Found.

DELETE {{HostAddress}}/api/calendar-events/REPLACE_WITH_EVENT_WITHOUT_THUMBNAIL_ID/thumbnail
Authorization: Bearer {{accessToken}}

### Upload thumbnail for a published event
# Use an event that has any platform publication row.
# Expected response: 409 Conflict. Delete platform publications before changing
# the thumbnail.

PUT {{HostAddress}}/api/calendar-events/REPLACE_WITH_PUBLISHED_EVENT_ID/thumbnail
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----YTSkedyThumbnailBoundary

------YTSkedyThumbnailBoundary
Content-Disposition: form-data; name="thumbnail"; filename="thumbnail.png"
Content-Type: image/png

< ../../../../../build/manual-checks/thumbnail.png
------YTSkedyThumbnailBoundary--

### Upload thumbnail with a read-only token
# Optional: paste a CalendarEvents.Read-only token into accessTokenReadOnly.
# Expected response: 403 Forbidden because upload requires CalendarEvents.Write.
# Skip this request if a read-only token is not available.

PUT {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/thumbnail
Authorization: Bearer {{accessTokenReadOnly}}
Content-Type: multipart/form-data; boundary=----YTSkedyThumbnailBoundary

------YTSkedyThumbnailBoundary
Content-Disposition: form-data; name="thumbnail"; filename="thumbnail.png"
Content-Type: image/png

< ../../../../../build/manual-checks/thumbnail.png
------YTSkedyThumbnailBoundary--

### Get thumbnail with a write-only token
# Optional: paste a CalendarEvents.Write-only token into accessTokenWriteOnly.
# Expected response: 403 Forbidden because read requires CalendarEvents.Read.
# Skip this request if a write-only token is not available.

GET {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/thumbnail
Authorization: Bearer {{accessTokenWriteOnly}}
