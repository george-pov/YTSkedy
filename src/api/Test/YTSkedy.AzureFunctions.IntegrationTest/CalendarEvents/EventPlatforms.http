# Per-event platform publication state is read from the calendar event detail
# endpoint GET /api/calendar-events/{calendarEventId} (its `platforms` array);
# see CalendarEvents/CreateCalendarEvent.http. There is no separate event-platform
# listing endpoint. This file covers the publish action.

### Publish a calendar event to a platform (success)
# Prereqs for a real publish:
# - The platform is backed by a configured YouTube channel whose credentials
#   reference matches the platform's publishSettings.credentials. See
#   docs/api/operations/youtube-publish-setup.md.
# - The calendar event has a FUTURE start and an English (en) title.
# Replace both ids. The request body is empty in this iteration.
# Expected response: 200 OK with { calendarEventId, platformId, platformName,
# platformType, status: "Published", externalResourceId, publishedUtc }. A
# private scheduled broadcast appears in YouTube Studio under Content > Live.

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish a calendar event to a WordPress platform (success)
# Prereqs for a real publish:
# - The WordPress platform was created with a local-only username and
#   Application Password in `http-client.env.json.user`.
# - The platform site URL points at a WordPress site whose
#   `/wp-json/wp/v2/posts` endpoint returns JSON.
# - The calendar event has a FUTURE start and an English (en) title.
# Replace both ids. Expected response: 200 OK with platformType "WordPress",
# status "Published", and externalResourceId set to the WordPress post id.

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_WORDPRESS_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish again (already published)
# Run after a successful publish of the same event/platform pair.
# Expected response: 409 Conflict (already published). State conflicts are
# checked before content validation.

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish an event whose start is in the past
# Use a calendar event id whose scheduled start has already passed and that has
# no publication row yet. Expected response: 400 Bad Request (start must be in
# the future).

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_PAST_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish an event with no English title
# Use a future calendar event that has no English (en) description.
# Expected response: 400 Bad Request (requires an English title to publish).

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_NON_ENGLISH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish to an unknown platform
# Expected response: 404 Not Found (platform).

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/00000000000000000000000000000000/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish an unknown calendar event
# Expected response: 404 Not Found (calendar event).

POST {{HostAddress}}/api/calendar-events/20000101T000000Z/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### Publish with a read-only token
# Optional: paste a `CalendarEvents.Read`-only token into `accessTokenReadOnly`.
# Expected response: 403 Forbidden (publish requires `CalendarEvents.Write`).
# Skip this request if a read-only token is not available.

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessTokenReadOnly}}

{}

### Publish to a platform whose YouTube channel is not configured
# Use a platform whose publishSettings.credentials points at a reference that is
# missing from the YouTubeChannels configuration section.
# Expected response: 502 Bad Gateway (provider failure). The attempt is
# released, so the pair returns to NotPublished and can be retried. The host log
# records only the non-secret credentials reference name.

POST {{HostAddress}}/api/calendar-events/REPLACE_WITH_CALENDAR_EVENT_ID/platforms/REPLACE_WITH_UNCONFIGURED_PLATFORM_ID/publish
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}
