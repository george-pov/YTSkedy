### Create calendar event
# Prereqs:
# - Azurite running and the Azure Functions host started.
# - The `local` environment is selected in the Visual Studio HTTP editor.
# - `accessToken` is set in `http-client.env.json.user` (not committed).
#   See docs/api/development/build-and-test.md, "Acquiring a development
#   access token".
# - After a successful create, copy the returned `calendarEventId` to
#   `calendarEventId` in `http-client.env.json.user`.
# - Change `localDateTime` after a successful run because scheduled starts are
#   unique.

POST {{HostAddress}}/api/calendar-events
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "start": {
    "localDateTime": "2026-06-07T10:00:00",
    "timeZoneId": "America/Vancouver"
  },
  "texts": [
    {
      "fieldKey": "text1",
      "value": "English stream 1"
    },
    {
      "fieldKey": "text2",
      "value": "Description for stream 1 in English"
    }
  ]
}

### Create calendar event with no bearer token
# Expected response: 401 Unauthorized with an empty body.

POST {{HostAddress}}/api/calendar-events
Content-Type: application/json

{
  "start": {
    "localDateTime": "2026-06-07T10:00:00",
    "timeZoneId": "America/Vancouver"
  },
  "texts": [
    { "fieldKey": "text1", "value": "Auth-missing probe" },
    { "fieldKey": "text2", "value": "Probe description" }
  ]
}

### Create calendar event with an invalid bearer token
# Expected response: 401 Unauthorized.

POST {{HostAddress}}/api/calendar-events
Content-Type: application/json
Authorization: Bearer not-a-jwt

{
  "start": {
    "localDateTime": "2026-06-08T10:00:00",
    "timeZoneId": "America/Vancouver"
  },
  "texts": [
    { "fieldKey": "text1", "value": "Auth-invalid probe" },
    { "fieldKey": "text2", "value": "Probe description" }
  ]
}

### Create calendar event with a read-only token
# Optional: paste a token that only carries the `CalendarEvents.Read`
# scope into `accessTokenReadOnly` (set in `http-client.env.json.user`).
# Expected response: 403 Forbidden (AuthorizationMiddleware short-circuits
# when the required `CalendarEvents.Write` scope is absent).
# Skip this request if a read-only token is not available.

POST {{HostAddress}}/api/calendar-events
Content-Type: application/json
Authorization: Bearer {{accessTokenReadOnly}}

{
  "start": {
    "localDateTime": "2026-06-09T10:00:00",
    "timeZoneId": "America/Vancouver"
  },
  "texts": [
    { "fieldKey": "text1", "value": "Scope-insufficient probe" },
    { "fieldKey": "text2", "value": "Probe description" }
  ]
}

### Get a calendar event by id (with embedded platform state)
# Replace the id with one returned by a create above. Used by the UI edit form
# to load an event. Expected response: 200 OK with the event fields, root
# `canUpdate`/`canDelete` flags, and a `platforms` array (the only place
# per-event publish state is exposed over HTTP), or 404 Not Found for an
# unknown id. Verify these states:
# - No platforms registered: `platforms` is [].
# - Active platform never published for this event: one item with status
#   "NotPublished", null externalResourceId/publishedUtc/platformDeletedUtc, and
#   canPublish true. Root canUpdate and canDelete are true when no publication
#   rows exist.
# - After a successful publish (see EventPlatforms.http): that platform's item
#   shows status "Published", a non-null externalResourceId and publishedUtc, and
#   canPublish false. Root canUpdate and canDelete are false while any
#   publication row exists.
# - After deleting a platform that had published this event: an orphan history
#   item with platformDeletedUtc set and canPublish false.

GET {{HostAddress}}/api/calendar-events/{{calendarEventId}}
Authorization: Bearer {{accessToken}}

### Update a calendar event's text values
# Replace the id with one returned by a create above. Only the text values
# change; the scheduled start is immutable. Expected response: 200 OK with
# { calendarEventId }, 404 Not Found for an unknown id, or 409 Conflict when
# any platform publication row exists for the event.

PUT {{HostAddress}}/api/calendar-events/{{calendarEventId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "texts": [
    {
      "fieldKey": "text1",
      "value": "English stream 1 (edited)"
    },
    {
      "fieldKey": "text2",
      "value": "Updated description for stream 1 in English"
    }
  ]
}

### Update a calendar event with a read-only token
# Optional: paste a `CalendarEvents.Read`-only token into `accessTokenReadOnly`.
# Expected response: 403 Forbidden (the update requires `CalendarEvents.Write`).
# Skip this request if a read-only token is not available.

PUT {{HostAddress}}/api/calendar-events/{{calendarEventId}}
Content-Type: application/json
Authorization: Bearer {{accessTokenReadOnly}}

{
  "texts": [
    { "fieldKey": "text1", "value": "Scope-insufficient update probe" },
    { "fieldKey": "text2", "value": "Probe description" }
  ]
}

