using '../main.bicep'

param environmentName = 'dev'
param location = 'westus2'
param resourceGroupName = 'rg-ytskedy-dev'
param functionAppName = 'func-ytskedy-api-dev'
param functionPlanName = 'asp-ytskedy-api-dev'
param functionStorageAccountName = 'stytskedyfuncdev'
param applicationStorageAccountName = 'stytskedydatadev'
param uiStorageAccountName = 'stytskedyuidev'
param applicationInsightsName = 'appi-ytskedy-api-dev'
param logAnalyticsWorkspaceName = 'log-ytskedy-dev'
param deploymentIdentityName = 'id-ytskedy-deploy-dev'
param federatedCredentialName = 'github-environment-dev'
param actionGroupName = 'ag-ytskedy-ops-dev'
param actionGroupShortName = 'ytskedydev'
param failureAnomalyAlertName = 'alert-ytskedy-failure-anomalies-dev'
param deploymentStorageContainerName = 'app-package-dev'
param repositoryName = 'george-pov/YTSkedy'
param authInstance = readEnvironmentVariable('YTSKEDY_DEV_AUTH_INSTANCE')
param authTenantId = readEnvironmentVariable('YTSKEDY_DEV_AUTH_TENANT_ID')
param authClientId = readEnvironmentVariable('YTSKEDY_DEV_AUTH_CLIENT_ID')
param authIssuer = readEnvironmentVariable('YTSKEDY_DEV_AUTH_ISSUER')
param authRequiredAppRole = 'CalendarEvents.Operator'
param publicationOperationTimeoutSeconds = 120
param publicationFinalizationTimeoutSeconds = 15
param publicationStaleAfterSeconds = 300
param alertReceiverName = readEnvironmentVariable('YTSKEDY_DEV_ALERT_RECEIVER_NAME')
param alertReceiverEmailAddress = readEnvironmentVariable('YTSKEDY_DEV_ALERT_RECEIVER_EMAIL_ADDRESS')
param logRetentionInDays = 30
param maximumInstanceCount = 100
param instanceMemoryMB = 2048
param enableResourceGroupDeleteLock = false
