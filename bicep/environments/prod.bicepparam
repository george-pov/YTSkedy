using '../main.bicep'

param environmentName = 'prod'
param location = 'westus2'
param resourceGroupName = 'rg-ytskedy-prod'
param functionAppName = 'func-ytskedy-api-prod'
param functionPlanName = 'asp-ytskedy-api-prod'
param functionStorageAccountName = 'stytskedyfuncprod'
param applicationStorageAccountName = 'stytskedydataprod'
param uiStorageAccountName = 'stytskedyuiprod'
param applicationInsightsName = 'appi-ytskedy-api-prod'
param logAnalyticsWorkspaceName = 'log-ytskedy-prod'
param deploymentIdentityName = 'id-ytskedy-deploy-prod'
param federatedCredentialName = 'github-environment-prod'
param actionGroupName = 'ag-ytskedy-ops-prod'
param actionGroupShortName = 'ytskedyprod'
param failureAnomalyAlertName = 'alert-ytskedy-failure-anomalies-prod'
param resourceGroupLockName = 'lock-ytskedy-prod-delete'
param deploymentStorageContainerName = 'app-package-prod'
param repositoryName = 'george-pov/YTSkedy'
param authInstance = readEnvironmentVariable('YTSKEDY_PROD_AUTH_INSTANCE')
param authTenantId = readEnvironmentVariable('YTSKEDY_PROD_AUTH_TENANT_ID')
param authClientId = readEnvironmentVariable('YTSKEDY_PROD_AUTH_CLIENT_ID')
param authIssuer = readEnvironmentVariable('YTSKEDY_PROD_AUTH_ISSUER')
param authRequiredAppRole = 'CalendarEvents.Operator'
param alertReceiverName = readEnvironmentVariable('YTSKEDY_PROD_ALERT_RECEIVER_NAME')
param alertReceiverEmailAddress = readEnvironmentVariable('YTSKEDY_PROD_ALERT_RECEIVER_EMAIL_ADDRESS')
param logRetentionInDays = 90
param maximumInstanceCount = 100
param instanceMemoryMB = 2048
param enableResourceGroupDeleteLock = true
